<%- include('navbar') %>
<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-white border-bottom">
          <h2 class="h5 mb-0"><%= item ? 'Edit' : 'Add' %> Photography Package</h2>
        </div>
        <div class="card-body">
          <form action="<%= item ? '/admin/photography-packages/update/' + item.id : '/admin/photography-packages/save' %>" method="POST">
            <div class="row g-3">
              <div class="col-md-6">
                <label for="name" class="form-label">Package Name</label>
                <input type="text" id="name" name="name" value="<%= item?.name || '' %>" class="form-control" required>
              </div>
              <div class="col-md-3">
                <label for="price" class="form-label">Price (₹)</label>
                <div class="input-group">
                  <span class="input-group-text">₹</span>
                  <input type="number" id="price" name="price" value="<%= item?.price || '' %>" class="form-control" required>
                </div>
              </div>
              <div class="col-md-3">
                <label for="duration" class="form-label">Duration</label>
                <input type="text" id="duration" name="duration" value="<%= item?.duration || '' %>" class="form-control" required>
              </div>
              <div class="col-md-6">
                <label for="edited_images" class="form-label">Edited Images</label>
                <input type="text" id="edited_images" name="edited_images" value="<%= item?.edited_images || '' %>" class="form-control" required>
              </div>
              <div class="col-md-6">
                <label for="photo_album" class="form-label">Photo Album</label>
                <input type="text" id="photo_album" name="photo_album" value="<%= item?.photo_album || '' %>" class="form-control">
              </div>
              
              <div class="col-12">
                <div class="row g-3">
                  <div class="col-md-3 col-6">
                    <div class="form-check form-switch">
                      <input class="form-check-input" type="checkbox" id="online_gallery" name="online_gallery" <%= item?.online_gallery ? 'checked' : '' %>>
                      <label class="form-check-label" for="online_gallery">Online Gallery</label>
                    </div>
                  </div>
                  <div class="col-md-3 col-6">
                    <div class="form-check form-switch">
                      <input class="form-check-input" type="checkbox" id="digital_download" name="digital_download" <%= item?.digital_download ? 'checked' : '' %>>
                      <label class="form-check-label" for="digital_download">Digital Download</label>
                    </div>
                  </div>
                  <div class="col-md-3 col-6">
                    <div class="form-check form-switch">
                      <input class="form-check-input" type="checkbox" id="print_release" name="print_release" <%= item?.print_release ? 'checked' : '' %>>
                      <label class="form-check-label" for="print_release">Print Release</label>
                    </div>
                  </div>
                  <div class="col-md-3 col-6">
                    <div class="form-check form-switch">
                      <input class="form-check-input" type="checkbox" id="second_photographer" name="second_photographer" <%= item?.second_photographer ? 'checked' : '' %>>
                      <label class="form-check-label" for="second_photographer">Second Photographer</label>
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="col-12">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="is_most_popular" name="is_most_popular" <%= item?.is_most_popular ? 'checked' : '' %>>
                  <label class="form-check-label fw-bold text-primary" for="is_most_popular">Mark as Most Popular</label>
                </div>
              </div>
              
              <div class="col-12">
                <div class="d-flex justify-content-end gap-2">
                  <% if (item) { %>
                    <a href="/admin/save" class="btn btn-outline-secondary">Cancel</a>
                  <% } %>
                  <button type="submit" class="btn btn-primary"><%= item ? 'Update' : 'Add' %> Package</button>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
      
      <div class="card shadow-sm">
        <div class="card-header bg-white border-bottom">
          <div class="d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">All Packages</h2>
            <div class="d-flex gap-2">
              <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Search packages...">
            </div>
          </div>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="bg-light">
                <tr>
                  <th>Name</th>
                  <th>Price</th>
                  <th>Duration</th>
                  <th>Images</th>
                  <th>Popular</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="packageTable">
                <% packages.forEach(pkg => { %>
                  <tr>
                    <td><strong><%= pkg.name %></strong></td>
                    <td>₹<%= pkg.price.toLocaleString() %></td>
                    <td><%= pkg.duration %></td>
                    <td><%= pkg.edited_images %></td>
                    <td>
                      <% if (pkg.is_most_popular) { %>
                        <span class="badge bg-success bg-opacity-10 text-success">Popular</span>
                      <% } %>
                    </td>
                    <td class="text-end">
                      <div class="d-flex gap-2 justify-content-end">
                        <a href="/admin/photography-packages/edit/<%= pkg.id %>" class="btn btn-sm btn-outline-primary">
                          <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a href="/admin/photography-packages/delete/<%= pkg.id %>" onclick="return confirm('Are you sure you want to delete this package?')" class="btn btn-sm btn-outline-danger">
                          <i class="bi bi-trash"></i> Delete
                        </a>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
        <% if (packages.length === 0) { %>
          <div class="card-body text-center py-5">
            <i class="bi bi-camera text-muted" style="font-size: 2rem;"></i>
            <p class="text-muted mt-3">No photography packages found</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<style>
  .form-switch .form-check-input {
    width: 2.5em;
    margin-left: -2.5em;
    height: 1.3em;
    margin-top: 0.15em;
  }
  .table td, .table th {
    vertical-align: middle;
  }
  @media (max-width: 768px) {
    .card-body {
      padding: 1rem;
    }
    .table-responsive {
      font-size: 0.875rem;
    }
    .btn-sm {
      padding: 0.25rem 0.5rem;
      font-size: 0.75rem;
    }
  }
</style>

<script>
  // Simple search functionality
  document.getElementById('searchInput').addEventListener('input', function() {
    const searchValue = this.value.toLowerCase();
    const rows = document.querySelectorAll('#packageTable tr');
    
    rows.forEach(row => {
      const text = row.textContent.toLowerCase();
      row.style.display = text.includes(searchValue) ? '' : 'none';
    });
  });
</script>

<%- include('footer') %>