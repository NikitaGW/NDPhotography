<%-include('navbar.ejs')%>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm form-card">
                <div class="card-header bg-primary text-white">
                    <h2 class="h4 mb-0">Update Service</h2>
                </div>
                <div class="card-body">
                    <form action="/admin/updateServices" method="POST" enctype="multipart/form-data" class="service-form">
                        <input type="hidden" name="u_id" value="<%= result[0].id %>">
                        
                        <div class="mb-3">
                            <label for="title" class="form-label">Title</label>
                            <input type="text" class="form-control" id="title" name="u_title" value="<%= result[0].title %>" required>
                        </div>
                        
                        <div class="mb-3">
                            <label for="event_date" class="form-label">Event Date</label>
                            <input type="date" class="form-control" id="event_date" name="u_event_date" value="<%= result[0].event_date %>" required>
                        </div>
                        
                        <div class="mb-3">
                            <label for="description" class="form-label">Description</label>
                            <textarea class="form-control" id="description" name="u_description" rows="4" required><%= result[0].description %></textarea>
                        </div>
                        
                        <div class="mb-3">
                            <label for="current_image" class="form-label">Current Image</label>
                            <div class="mb-2">
                                <img src="/images/<%= result[0].image_path %>" class="img-thumbnail" style="max-height: 150px;" alt="Current service image">
                            </div>
                            <label for="image" class="form-label">Update Image (leave blank to keep current)</label>
                            <input type="file" class="form-control" id="image" name="u_image" accept="image/*">
                        </div>
                        
                        <div class="mb-4">
                            <label for="category" class="form-label">Category</label>
                            <select class="form-select" id="category" name="category" required>
                                <% for(var i=0; i<result2.length; i++) { %>
                                    <option value="<%- result2[i].category_id %>" 
                                        <%= result2[i].category_id === result[0].category_id ? 'selected' : '' %>>
                                        <%- result2[i].category_name %>
                                    </option>
                                <% } %>
                            </select>
                        </div>
                        
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-primary px-4">Update Service</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%-include('footer.ejs')%>

<style>
    .form-card {
        border-radius: 10px;
        overflow: hidden;
    }
    
    .card-header {
        padding: 1.25rem 1.5rem;
    }
    
    .form-control, .form-select {
        padding: 0.75rem 1rem;
        border-radius: 0.375rem;
        border: 1px solid #ced4da;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
    
    .btn-primary {
        background-color: #0d6efd;
        border: none;
        padding: 0.625rem 1.5rem;
        font-weight: 500;
    }
    
    .btn-primary:hover {
        background-color: #0b5ed7;
    }
    
    @media (max-width: 768px) {
        .card-body {
            padding: 1.25rem;
        }
        
        .d-md-flex {
            display: flex !important;
            justify-content: center !important;
        }
        
        .btn {
            width: 100%;
        }
    }
    
    @media (max-width: 576px) {
        .container {
            padding-left: 15px;
            padding-right: 15px;
        }
        
        .card-header h2 {
            font-size: 1.25rem;
        }
    }
</style>
<%- include('footer')%>