<%- include('navbar') %>

<div class="slider-admin-container">
  <div class="slider-admin-header">
    <h1 class="slider-admin-title">Slider Management</h1>
    <p class="slider-admin-subtitle">Update your homepage slider content and images</p>
  </div>

  <div class="slider-preview-container">
    <div class="preview-header">
      <h2>Current Slider Preview</h2>
      <a href="/admin/update_slider" class="btn-edit-slider">
        <i class="fas fa-edit"></i> Edit Slider
      </a>
    </div>

    <section class="hero-section">
      <!-- Hero Slides -->
      <div class="hero-slide active" style="background-image: url('/images/<%=sliderResult[0].image1%>');"></div>
      <div class="hero-slide" style="background-image: url('/images/<%= sliderResult[0].image2%>');"></div>
      <div class="hero-slide" style="background-image: url('/images/<%= sliderResult[0].image3%>');"></div>
      
      <!-- Overlay -->
      <div class="hero-overlay"></div>
      
      <!-- Hero Content -->
      <div class="container hero-content">
        <h1 class="tagline"><%= sliderResult[0].heading%></h1>
        <p class="sub-tagline"><%=sliderResult[0].description%></p>
        <div class="hero-buttons">
          <a href="<%= sliderResult[0].button1_link%>" class="btn btn-primary">
            <%= sliderResult[0].button1_text%>
          </a>
          <a href="<%= sliderResult[0].button2_link%>" class="btn btn-secondary">
            <%= sliderResult[0].button2_text%>
          </a>
        </div>
      </div>
    </section>

    <div class="slider-details">
      <div class="detail-card">
        <h3>Slider Images</h3>
        <div class="image-previews">
          <div class="image-preview">
            <img src="/images/<%=sliderResult[0].image1%>" alt="Slider Image 1">
            <span>Image 1</span>
          </div>
          <div class="image-preview">
            <img src="/images/<%=sliderResult[0].image2%>" alt="Slider Image 2">
            <span>Image 2</span>
          </div>
          <div class="image-preview">
            <img src="/images/<%=sliderResult[0].image3%>" alt="Slider Image 3">
            <span>Image 3</span>
          </div>
        </div>
      </div>

      <div class="detail-card">
        <h3>Current Content</h3>
        <div class="content-details">
          <div class="detail-item">
            <label>Heading:</label>
            <p><%= sliderResult[0].heading%></p>
          </div>
          <div class="detail-item">
            <label>Description:</label>
            <p><%= sliderResult[0].description%></p>
          </div>
          <div class="detail-item">
            <label>Primary Button:</label>
            <p><%= sliderResult[0].button1_text%> (links to: <%= sliderResult[0].button1_link%>)</p>
          </div>
          <div class="detail-item">
            <label>Secondary Button:</label>
            <p><%= sliderResult[0].button2_text%> (links to: <%= sliderResult[0].button2_link%>)</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Base Styles */
  :root {
    --primary-color: #4361ee;
    --primary-dark: #3a56d4;
    --secondary-color: #6c757d;
    --light-color: #f8f9fa;
    --dark-color: #212529;
    --border-color: #dee2e6;
    --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.1);
    --transition: all 0.3s ease;
  }

  /* Admin Container */
  .slider-admin-container {
    max-width: 1400px;
    margin: 2rem auto;
    padding: 0 1.5rem;
  }

  .slider-admin-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .slider-admin-title {
    color: var(--dark-color);
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .slider-admin-subtitle {
    color: var(--secondary-color);
    font-size: 1.1rem;
  }

  /* Preview Container */
  .slider-preview-container {
    background: white;
    border-radius: 10px;
    box-shadow: var(--card-shadow);
    overflow: hidden;
    margin-bottom: 3rem;
  }

  .preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .preview-header h2 {
    color: var(--dark-color);
    font-size: 1.5rem;
    margin: 0;
  }

  .btn-edit-slider {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.25rem;
    background-color: var(--primary-color);
    color: white;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 500;
    transition: var(--transition);
  }

  .btn-edit-slider:hover {
    background-color: var(--primary-dark);
    transform: translateY(-2px);
  }

  .btn-edit-slider i {
    margin-right: 0.5rem;
  }

  /* Hero Section Styles */
  .hero-section {
    height: 70vh;
    min-height: 500px;
    position: relative;
    overflow: hidden;
  }
  
  .hero-slide {
    position: absolute;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
    z-index: 1;
  }
  
  .hero-slide.active {
    opacity: 1;
  }
  
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 2;
  }
  
  .hero-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    max-width: 1200px;
    padding: 0 2rem;
    text-align: center;
    z-index: 3;
    color: white;
  }
  
  .tagline {
    font-size: 3rem;
    font-weight: 700;
    text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.5);
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }
  
  .sub-tagline {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
  }

  .hero-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 6px;
    font-weight: 500;
    text-decoration: none;
    transition: var(--transition);
    min-width: 160px;
    text-align: center;
  }

  .btn-primary {
    background-color: var(--primary-color);
    color: white;
    border: 2px solid var(--primary-color);
  }

  .btn-primary:hover {
    background-color: var(--primary-dark);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background-color: transparent;
    color: white;
    border: 2px solid white;
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  /* Slider Details */
  .slider-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
  }

  .detail-card {
    background-color: var(--light-color);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .detail-card h3 {
    color: var(--dark-color);
    margin-top: 0;
    margin-bottom: 1.5rem;
    font-size: 1.25rem;
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .image-previews {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .image-preview {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .image-preview img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 0.5rem;
    border: 1px solid var(--border-color);
  }

  .image-preview span {
    font-size: 0.9rem;
    color: var(--secondary-color);
  }

  .content-details {
    display: grid;
    gap: 1.25rem;
  }

  .detail-item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1rem;
  }

  .detail-item label {
    font-weight: 500;
    color: var(--dark-color);
  }

  .detail-item p {
    margin: 0;
    color: var(--secondary-color);
  }

  /* Responsive Adjustments */
  @media (max-width: 992px) {
    .slider-details {
      grid-template-columns: 1fr;
    }

    .tagline {
      font-size: 2.5rem;
    }

    .sub-tagline {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      height: 60vh;
      min-height: 400px;
    }

    .tagline {
      font-size: 2rem;
    }

    .hero-buttons {
      flex-direction: column;
      align-items: center;
    }

    .btn {
      width: 100%;
      max-width: 250px;
    }

    .image-previews {
      grid-template-columns: 1fr;
    }

    .detail-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  @media (max-width: 576px) {
    .hero-section {
      height: 70vh;
    }

    .hero-content {
      padding: 0 1rem;
    }

    .tagline {
      font-size: 1.75rem;
    }

    .slider-admin-title {
      font-size: 1.75rem;
    }

    .preview-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .btn-edit-slider {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  // Simple slider animation
  document.addEventListener('DOMContentLoaded', function() {
    const slides = document.querySelectorAll('.hero-slide');
    let currentSlide = 0;
    
    function nextSlide() {
      slides[currentSlide].classList.remove('active');
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.add('active');
    }
    
    if (slides.length > 1) {
      setInterval(nextSlide, 5000);
    }
  });
</script>

<%- include('footer') %>