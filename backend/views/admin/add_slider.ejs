<%- include('navbar') %>

<style>
    .slider-form-wrapper {
        background-color: #fff;
        border-radius: 10px;
        padding: 2rem;
        margin: 2rem auto;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
    }

    .slider-form-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #343a40;
        margin-bottom: 1.5rem;
        border-bottom: 2px solid #0d6efd;
        padding-bottom: 0.5rem;
    }

    .slider-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 0.5rem;
    }

    .slider-input,
    .slider-textarea {
        width: 100%;
        padding: 0.5rem;
        border-radius: 6px;
        border: 1px solid #ced4da;
        font-size: 1rem;
    }

    .slider-textarea {
        resize: vertical;
    }

    .slider-input:focus,
    .slider-textarea:focus {
        outline: none;
        border-color: #0d6efd;
    }

    .slider-submit-btn {
        background-color: #0d6efd;
        color: #fff;
        font-weight: 600;
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 6px;
        transition: all 0.3s;
    }

    .slider-submit-btn:hover {
        background-color: #0b5ed7;
        transform: translateY(-2px);
    }

    .slider-row {
        margin-bottom: 1.2rem;
    }

    .slider-file {
        width: 100%;
        padding: 0.4rem;
        border-radius: 6px;
        border: 1px solid #ccc;
    }
</style>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <form class="slider-form-wrapper" method="POST" action="/admin/save_slider" enctype="multipart/form-data">
                <h2 class="slider-form-title">Add Slider Content</h2>

                <div class="slider-row">
                    <label class="slider-label">Slider Heading</label>
                    <input type="text" name="heading" class="slider-input" required />
                </div>

                <div class="slider-row">
                    <label class="slider-label">Slider Description</label>
                    <textarea name="description" rows="3" class="slider-textarea" required></textarea>
                </div>

                <!-- Images -->
                <div class="row">
                    <div class="col-md-6 slider-row">
                        <label class="slider-label">Image 1</label>
                        <input type="file" name="image1" class="slider-file" accept="image/*" required />
                    </div>
                    <div class="col-md-6 slider-row">
                        <label class="slider-label">Image 2</label>
                        <input type="file" name="image2" class="slider-file" accept="image/*" required />
                    </div>
                    <div class="col-md-6 slider-row">
                        <label class="slider-label">Image 3</label>
                        <input type="file" name="image3" class="slider-file" accept="image/*" required />
                    </div>
                    <div class="col-md-6 slider-row">
                        <label class="slider-label">Image 4</label>
                        <input type="file" name="image4" class="slider-file" accept="image/*" required />
                    </div>
                </div>

                <!-- Buttons -->
                <div class="row">
                    <div class="col-md-6 slider-row">
                        <label class="slider-label">Button 1 Text</label>
                        <input type="text" name="button1_text" class="slider-input" />
                    </div>
                    <div class="col-md-6 slider-row">
                        <label class="slider-label">Button 1 Link</label>
                        <input type="url" name="button1_link" class="slider-input" />
                    </div>
                    <div class="col-md-6 slider-row">
                        <label class="slider-label">Button 2 Text</label>
                        <input type="text" name="button2_text" class="slider-input" />
                    </div>
                    <div class="col-md-6 slider-row">
                        <label class="slider-label">Button 2 Link</label>
                        <input type="url" name="button2_link" class="slider-input" />
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="slider-submit-btn">
                        <i class="bi bi-upload me-2"></i> Save Slider
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('footer') %>
