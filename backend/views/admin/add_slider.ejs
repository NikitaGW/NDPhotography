<%- include('navbar') %>
<style>
    .hero-section {
            height: 80vh;
            min-height: 600px;
            position: relative;
            overflow: hidden;
        }
        
        .hero-slide {
            position: absolute;
            width: 100%;
            height: 100%;
            background-size: cover;
            background-position: center;
            opacity: 0;
            transition: opacity 1.5s ease-in-out;
            z-index: 1;
        }
        
        .hero-slide.active {
            opacity: 1;
        }
        
        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 2;
        }
        
        .hero-content {
            position: relative;
            z-index: 3;
            color: white;
        }
        
        .tagline {
            font-size: 3.5rem;
            font-weight: 700;
            text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.5);
        }
        
        .sub-tagline {
            font-size: 1.5rem;
            margin-bottom: 2rem;
        }
        .sliderBox{
            padding: 20px;
        }
        .btn-outline-light{
            border: 1px solid rgba(255, 255, 255, 0.7);
        }
        .editBtn
        {
            z-index: 1111;
            position: absolute;
            top:20px;
            right: 20px;
            padding: 3px 20px;
            background-color: transparent;
            background-origin: 1px solid rgba(255, 255, 255, 0.7);
            color: white;
            outline: none;
            font-weight: 600;
        }
        .editBtn:hover{
            background-color: rgba(255, 255, 255);
            color: black ;
            border: 1px solid rgba(40, 39, 39, 0.7);
            cursor: pointer;
        }
        
</style>
<div class="sliderBox">
    <section class="hero-section d-flex align-items-center">
        <!-- Hero Slides -->
        <div class="hero-slide active" style="background-image: url('/images/<%=sliderResult[0].image1%>');"></div>
        <div class="hero-slide" style="background-image: url('/images/<%= sliderResult[0].image2%>');"></div>
        <div class="hero-slide" style="background-image: url('/images/<%= sliderResult[0].image3%>');"></div>
        
        <!-- Overlay -->
        <div class="hero-overlay"></div>
        
        <!-- Hero Content -->
        <div class="container hero-content text-center">
            <h1 class="tagline mb-3 animate-on-scroll"><%= sliderResult[0].heading%></h1>
            <p class="sub-tagline animate-on-scroll delay-1"><%=sliderResult[0].description%></p>
            <div class="d-flex justify-content-center gap-3 animate-on-scroll delay-2">
                <a href="<%= sliderResult[0].button1_link%>" class="btn btn-primary btn-lg"><%= sliderResult[0].button1_text%></a>
                <a href="<%= sliderResult[0].button2_link%>" class="btn btn-outline-light btn-lg"><%= sliderResult[0].button2_text%></a>
            </div>
        </div>
        <a href="/admin/update_slider"><button class="editBtn text-capitalize">update</button></a>
    </section>
    

</div>
<%- include('footer') %>
