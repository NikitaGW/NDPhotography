
<%- include('navbar') %>

<div class="container mt-5">
  <h2 class="mb-4">Update About Hero Section</h2>
  <form action="/admin/save_about" method="POST" enctype="multipart/form-data">
    
    <!-- Hidden field for update -->
    <input type="hidden" name="hero_id" value="<%= typeof result !== 'undefined' ? result.id : '' %>">

    <!-- Hero Title -->
    <div class="mb-3">
      <label for="hero_title" class="form-label">Hero Title</label>
      <input type="text" class="form-control" id="hero_title" name="hero_title" placeholder="Enter Hero Title"
        value="<%= typeof result !== 'undefined' ? result.hero_title : '' %>" required>
    </div>

    <!-- Hero Subtitle -->
    <div class="mb-3">
      <label for="hero_subtitle" class="form-label">Hero Subtitle</label>
      <input type="text" class="form-control" id="hero_subtitle" name="hero_subtitle" placeholder="Enter Hero Subtitle"
        value="<%= typeof result !== 'undefined' ? result.hero_subtitle : '' %>" required>
    </div>

    <!-- Background Image Upload -->
    <div class="mb-3">
      <label for="hero_image" class="form-label">Hero Background Image</label>
      <input type="file" class="form-control" id="hero_image" name="hero_image">
      <% if (typeof result !== 'undefined' && result.hero_image_url) { %>
        <img src="/uploads/<%= result.hero_image_url %>" alt="Current Hero Image" width="200" class="mt-2">
      <% } %>
    </div>

    <!-- Submit Button -->
    <button type="submit" class="btn btn-primary">Save</button>
  </form>
</div>

<%- include('footer') %>
