<%- include('navbar') %>

<div class="container mt-5">
  <h2>Edit About Banner Data Directly</h2>
  <% if (banners && banners.length > 0) { %>
    <% for (var i = 0; i < banners.length; i++) { %>
      <form action="/admin/save_about" method="POST" enctype="multipart/form-data" class="mb-5 p-4 border rounded">
        <input type="hidden" name="id" value="<%= banners[i].id %>">
        <div class="mb-3">
          <label for="title_<%= i %>" class="form-label">Hero Title</label>
          <input type="text" class="form-control" id="title_<%= i %>" name="title" value="<%= banners[i].title %>" required>
        </div>
        <div class="mb-3">
          <label for="subtitle_<%= i %>" class="form-label">Hero Subtitle</label>
          <input type="text" class="form-control" id="subtitle_<%= i %>" name="subtitle" value="<%= banners[i].subtitle %>" required>
        </div>
        <div class="mb-3">
          <label for="background_image_<%= i %>" class="form-label">Hero Background Image</label>
          <% if (banners[i].background_image) { %>
            <div class="mb-2">
              <img src="/images/<%= banners[i].background_image %>" alt="Current Image" style="max-width: 120px; max-height: 80px;">
            </div>
          <% } %>
          <input type="file" class="form-control" id="background_image_<%= i %>" name="background_image">
          <input type="hidden" name="existing_background_image" value="<%= banners[i].background_image %>">
        </div>
        <button type="submit" class="btn btn-success">Save Changes</button>
      </form>
    <% } %>
  <% } else { %>
    <div class="alert alert-info">No About Banner data found.</div>
  <% } %>
</div>
<%- include('footer') %>