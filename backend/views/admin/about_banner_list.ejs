<%- include('navbar') %>


<style>
  .hero-section {
    background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
      url('https://images.unsplash.com/photo-1516035069371-29a1b244cc32?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');
    background-size: cover;
    background-position: center;
    color: white;
    padding: 120px 0;
    margin-bottom: 50px;
  }

  .section-title {
    position: relative;
    margin-bottom: 40px;
    color: var(--primary-color);
  }

  .section-title:after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 60px;
    height: 3px;
    background-color: var(--secondary-color);
  }

  .form-container {
    margin: 50px auto;
    max-width: 600px;
  }
</style>
<section class="hero-section text-center">
  
  <h1 class="display-3 fw-bold mb-4">About Me</h1>
  <p class="lead">Capturing moments, telling stories, creating art</p>
</section>

<div class="container form-container">
  <div class="card shadow-lg border-0 rounded-3">
    <div class="card-body p-4">
      <h2 class="text-center mb-4">About Banners</h2>
      <table class="table table-striped table-bordered align-middle text-center">
        <thead>
          <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Subtitle</th>
            <th>Image</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% banners.forEach(banner => { %>
            <tr>
              <td><%= banner.id %></td>
              <td><%= banner.title %></td>
              <td><%= banner.subtitle %></td>
              <td><img src="/images/<%= banner.background_image %>" alt="<%= banner.title %>" class="img-fluid" style="max-width: 150px;"></td>
              <td>
                <a href="/admin/update_about_banner/<%= banner.id %>" class="btn btn-success btn-sm">Edit</a>
                <a href="/admin/delete_about_banner/<%= banner.id %>" class="btn btn-danger btn-sm">Delete</a>

                
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('footer') %>