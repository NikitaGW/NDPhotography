<%- include('navbar') %>

<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom py-3">
          <div class="d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">
              <i class="bi bi-plus-circle-fill text-primary me-2"></i>
              <%= addon ? 'Edit' : 'Add' %> Add-On
            </h2>
            <a href="/admin/addons" class="btn btn-sm btn-outline-secondary">
              <i class="bi bi-arrow-left me-1"></i> Back to Add-Ons
            </a>
          </div>
        </div>
        
        <div class="card-body">
          <form action="<%= addon ? '/admin/addons/update/' + addon.id : '/admin/addons/save' %>" method="POST">
            <div class="row g-3">
              <div class="col-md-12">
                <label for="title" class="form-label fw-semibold">Title</label>
                <div class="input-group">
                  <span class="input-group-text bg-light">
                    <i class="bi bi-card-heading text-muted"></i>
                  </span>
                  <input type="text" id="title" name="title" class="form-control form-control-lg" 
                         value="<%= addon ? addon.title : '' %>" required
                         placeholder="Enter add-on title">
                </div>
              </div>
              
              <div class="col-md-6">
                <label for="price" class="form-label fw-semibold">Price</label>
                <div class="input-group">
                  <span class="input-group-text bg-light">₹</span>
                  <input type="text" id="price" name="price" class="form-control" 
                         value="<%= addon ? addon.price : '' %>" required
                         placeholder="0.00">
                </div>
              </div>
              
              <div class="col-md-12">
                <label for="description" class="form-label fw-semibold">Description</label>
                <textarea id="description" name="description" class="form-control" rows="4"
                          placeholder="Detailed description of the add-on"><%= addon ? addon.description : '' %></textarea>
              </div>
              
              <div class="col-12">
                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                  <a href="/admin/addons" class="btn btn-lg btn-outline-secondary px-4">
                    Cancel
                  </a>
                  <button type="submit" class="btn btn-lg btn-primary px-4">
                    <i class="bi bi-save me-2"></i>Save Add-On
                  </button>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .form-control-lg {
    padding: 0.75rem 1rem;
    font-size: 1.05rem;
  }
  .input-group-text {
    min-width: 45px;
    justify-content: center;
  }
  @media (max-width: 768px) {
    .card-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .btn-lg {
      padding: 0.5rem 1rem;
      font-size: 1rem;
    }
  }
</style>

<%- include('footer') %>