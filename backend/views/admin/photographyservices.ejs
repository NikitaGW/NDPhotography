<%-include('navbar')%>
<link rel="stylesheet" href="/admin/services.css">
<div class="admin-container">
  <div class="admin-content">
    <!-- Category Form Card -->
    <div class="card form-card">
      <div class="card-header">
        <h2><i class="fas fa-tags"></i> Category Management</h2>
      </div>
      <div class="card-body">
        <form action="/admin/saveCategory" method="post" class="category-form">
          <div class="form-group">
            <label for="categoryName" class="form-label">Add New Category</label>
            <div class="input-group">
              <input type="text" id="categoryName" name="categoryName" class="form-control" placeholder="Enter category name" required>
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add
              </button>
            </div>
          </div>
        </form>

        <!-- Categories Table -->
        <div class="table-responsive">
          <table class="categories-table">
            <thead>
              <tr>
                <th width="60px">#</th>
                <th>Category Name</th>
                <th width="120px">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (categoryResult.length > 0) { %>
                <% for(let i = 0; i < categoryResult.length; i++) { %>
                  <tr>
                    <td><%= i+1 %></td>
                    <td><%= categoryResult[i].category_name %></td>
                    <td class="actions">
  <a href="#"
     class="btn btn-sm btn-edit"
     data-bs-toggle="modal"
     data-bs-target="#editCategoryModal"
     data-id="<%= categoryResult[i].category_id %>"
     data-name="<%= categoryResult[i].category_name %>"
     title="Edit">
    <i class="fas fa-edit"></i>
  </a>

  <a href="/admin/deleteCategory/<%= categoryResult[i].category_id %>"
     class="btn btn-sm btn-delete"
     title="Delete"
     onclick="return confirm('Are you sure you want to delete this category?')">
    <i class="fas fa-trash-alt"></i>
  </a>
</td>

                  </tr>
                <% } %>
              <% } else { %>
                <tr>
                  <td colspan="3" class="text-center py-4">No categories found. Add your first category above.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Services Management Section -->
    <div class="card">
      <div class="card-header">
        <h2><i class="fas fa-images"></i> Services Management</h2>
      </div>
      <div class="card-body">
        <!-- Add New Service Form -->
        <div class="service-form-container">
          <h3 class="section-title">Add New Service</h3>
          <form action="/admin/saveServices" method="POST" enctype="multipart/form-data" class="service-form">
            <div class="form-row">
              <div class="form-group col-md-6">
                <label for="title">Title</label>
                <input type="text" id="title" name="title" class="form-control" required>
              </div>
              
              <div class="form-group col-md-6">
                <label for="event_date">Event Date</label>
                <input type="date" id="event_date" name="event_date" class="form-control" required>
              </div>
            </div>
            
            <div class="form-group">
              <label for="category">Category</label>
              <select name="category" id="category" class="form-control" required>
                <%for(let i = 0;i < categoryResult.length; i++) {%>
                  <option value="<%-categoryResult[i].category_id %>"><%-categoryResult[i].category_name %></option>
                  <%} %>
              </select>
            </div>
            
            <div class="form-group">
              <label for="description">Description</label>
              <textarea id="description" name="description" rows="4" class="form-control" required></textarea>
            </div>
            
            <div class="form-group">
              <label for="image">Image</label>
              <div class="file-upload-wrapper">
                <input type="file" id="image" name="image" accept="image/*" class="form-control file-upload" required>
                <label for="image" class="file-upload-label">
                  <i class="fas fa-cloud-upload-alt"></i> Choose an image file...
                </label>
              </div>
            </div>
            
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Save Service
              </button>
            </div>
          </form>
        </div>

        <!-- Services Table -->
