<form action="/admin/about/bio" method="POST" enctype="multipart/form-data">
  <input type="text" name="heading" value="<%= bio.heading %>" class="form-control mb-2" placeholder="Heading" required>
  <% if (bio.image) { %>
    <img src="<%= bio.image %>" width="200"><br>
  <% } %>
  <input type="hidden" name="old_image" value="<%= bio.image %>">
  <input type="file" name="image" class="form-control mb-2">
  <textarea name="paragraph_1" class="form-control mb-2" rows="3"><%= bio.paragraph_1 %></textarea>
  <textarea name="paragraph_2" class="form-control mb-2" rows="3"><%= bio.paragraph_2 %></textarea>
  <textarea name="paragraph_3" class="form-control mb-2" rows="3"><%= bio.paragraph_3 %></textarea>
  <button class="btn btn-success">Save</button>
</form>
