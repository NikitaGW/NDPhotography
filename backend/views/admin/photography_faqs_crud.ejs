<%- include('navbar') %>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-white border-bottom">
          <h2 class="h5 mb-0"><%= faq ? 'Edit' : 'Add' %> FAQ</h2>
        </div>
        <div class="card-body">
          <form action="<%= faq ? '/admin/photography-faqs/update/' + faq.id : '/admin/photography-faqs/save' %>" method="POST">
            <div class="mb-4">
              <label for="question" class="form-label fw-semibold">Question</label>
              <input type="text" id="question" name="question" class="form-control form-control-lg" required 
                     value="<%= faq?.question || '' %>" placeholder="Enter the frequently asked question">
            </div>

            <div class="mb-4">
              <label for="answer" class="form-label fw-semibold">Answer</label>
              <textarea id="answer" name="answer" class="form-control" required rows="6"
                        placeholder="Provide a detailed answer"><%= faq?.answer || '' %></textarea>
            </div>

            <div class="d-flex justify-content-end">
              <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-save me-2"></i><%= faq ? 'Update' : 'Add' %> FAQ
              </button>
            </div>
          </form>
        </div>
      </div>

      <div class="card shadow-sm">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
          <h2 class="h5 mb-0">All FAQs</h2>
          <div>
            <input type="text" id="searchFAQs" class="form-control form-control-sm" placeholder="Search FAQs...">
          </div>
        </div>
        <div class="card-body p-0">
          <% if (faqs.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="bg-light">
                  <tr>
                    <th width="5%">#</th>
                    <th width="25%">Question</th>
                    <th width="55%">Answer</th>
                    <th width="15%" class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody id="faqsTable">
                  <% faqs.forEach((item, i) => { %>
                    <tr>
                      <td class="text-muted"><%= i + 1 %></td>
                      <td class="fw-semibold"><%= item.question %></td>
                      <td class="text-truncate" style="max-width: 300px;" title="<%= item.answer %>">
                        <%= item.answer.length > 100 ? item.answer.substring(0, 100) + '...' : item.answer %>
                      </td>
                      <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end">
                          <a href="/admin/photography-faqs/edit/<%= item.id %>" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                          </a>
                          <a href="/admin/photography-faqs/delete/<%= item.id %>" 
                             onclick="return confirm('Are you sure you want to delete this FAQ?')" 
                             class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-5">
              <i class="bi bi-question-circle text-muted" style="font-size: 2.5rem;"></i>
              <h5 class="mt-3 text-muted">No FAQs Found</h5>
              <p class="text-muted">Add your first FAQ using the form above</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .form-control-lg {
    padding: 0.75rem 1rem;
    font-size: 1.05rem;
  }
  .table td {
    vertical-align: middle;
  }
  .text-truncate {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 768px) {
    .card-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .table-responsive {
      font-size: 0.875rem;
    }
    .table thead {
      display: none;
    }
    .table tr {
      display: block;
      margin-bottom: 1rem;
      border: 1px solid #dee2e6;
      border-radius: 0.25rem;
    }
    .table td {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem;
      border-bottom: 1px solid #f0f0f0;
    }
    .table td:before {
      content: attr(data-label);
      font-weight: 600;
      margin-right: 1rem;
    }
    .table td.text-end {
      justify-content: flex-end;
    }
    .text-truncate {
      white-space: normal;
    }
  }
</style>

<script>
  // Make table rows clickable on mobile
  document.querySelectorAll('#faqsTable tr').forEach(row => {
    row.setAttribute('data-label', 'FAQ');
    row.querySelectorAll('td').forEach((cell, index) => {
      const headers = ['#', 'Question', 'Answer', 'Actions'];
      if (index < headers.length) {
        cell.setAttribute('data-label', headers[index]);
      }
    });
  });

  // Search functionality
  document.getElementById('searchFAQs').addEventListener('input', function() {
    const searchValue = this.value.toLowerCase();
    const rows = document.querySelectorAll('#faqsTable tr');
    
    rows.forEach(row => {
      const text = row.textContent.toLowerCase();
      row.style.display = text.includes(searchValue) ? '' : 'none';
    });
  });
</script>

<%- include('footer') %>