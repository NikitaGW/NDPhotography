<%- include('navbar') %>

<div class="testimonial-dashboard">
  <div class="dashboard-header">
    <div class="header-content">
      <h1>Customer Testimonials</h1>
      <p>Manage and showcase customer feedback</p>
    </div>
  </div>

  <div class="dashboard-container">
    <!-- Add Testimonial Card -->
    <div class="dashboard-card add-testimonial">
      <div class="card-header">
        <h2>
          <i class="fas fa-plus-circle"></i>
          Add New Testimonial
        </h2>
      </div>
      <div class="card-body">
        <form action="/admin/save_home_testimonial" method="POST" enctype="multipart/form-data">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Customer Name <span class="required">*</span></label>
              <input type="text" id="name" name="name" required placeholder="John Smith">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="category">Category</label>
              <input type="text" id="category" name="category" placeholder="VIP Client">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="description">Testimonial Content <span class="required">*</span></label>
              <textarea id="description" name="description" rows="4" required placeholder="What they said about your service..."></textarea>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">
              <i class="fas fa-save"></i> Save Testimonial
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Testimonials List Card -->
    <div class="dashboard-card testimonial-list">
      <div class="card-header">
        <div class="header-title">
          <h2>
            <i class="fas fa-list"></i>
            Current Testimonials
          </h2>
          <span class="badge"><%= homeTestimonialsResult.length %></span>
        </div>
        <div class="header-actions">
          <div class="search-box">
            <input type="text" placeholder="Search testimonials...">
            <i class="fas fa-search"></i>
          </div>
        </div>
      </div>
      
      <div class="card-body">
        <% if (homeTestimonialsResult.length > 0) { %>
          <div class="responsive-table">
            <table>
              <thead>
                <tr>
                  <th>#</th>
                  <th>Customer</th>
                  <th>Testimonial</th>
                  <th>Category</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% for (let i = 0; i < homeTestimonialsResult.length; i++) { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td class="customer-cell">
                      <div class="customer-info">
                        <div class="customer-name"><%= homeTestimonialsResult[i].name %></div>
                      </div>
                    </td>
                    <td class="testimonial-cell">
                      <div class="testimonial-preview">
                        <%= homeTestimonialsResult[i].description.length > 100 ? 
                          homeTestimonialsResult[i].description.substring(0, 100) + '...' : 
                          homeTestimonialsResult[i].description %>
                      </div>
                    </td>
                    <td>
                      <span class="category-tag"><%= homeTestimonialsResult[i].category || 'General' %></span>
                    </td>
                    <td class="actions-cell">
                      <div class="action-buttons">
                        <a href="/admin/edit_home_testimonial/<%= homeTestimonialsResult[i].id %>" class="btn btn-edit">
                          <i class="fas fa-pencil-alt"></i>
                        </a>
                        <a href="/admin/delete_home_testimonial/<%= homeTestimonialsResult[i].id %>" 
                           class="btn btn-delete"
                           onclick="return confirm('Are you sure you want to delete this testimonial?')">
                          <i class="fas fa-trash"></i>
                        </a>
                      </div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-icon">
              <i class="fas fa-comment-dots"></i>
            </div>
            <h3>No Testimonials Yet</h3>
            <p>Add your first testimonial to showcase customer feedback</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<style>
  /* Base Variables */
  :root {
    --primary: #4361ee;
    --primary-light: #eef1fe;
    --primary-dark: #3a56d4;
    --secondary: #6c757d;
    --success: #28a745;
    --danger: #dc3545;
    --warning: #ffc107;
    --light: #f8f9fa;
    --dark: #212529;
    --gray: #6c757d;
    --light-gray: #e9ecef;
    --border: #dee2e6;
    --shadow: 0 2px 15px rgba(0, 0, 0, 0.05);
    --radius: 8px;
    --transition: all 0.3s ease;
  }

  /* Base Styles */
  .testimonial-dashboard {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: var(--dark);
    line-height: 1.6;
    padding-bottom: 2rem;
  }

  /* Header Styles */
  .dashboard-header {
    background: white;
    padding: 1.5rem 2rem;
    margin-bottom: 2rem;
    box-shadow: var(--shadow);
  }

  .header-content h1 {
    font-size: 1.8rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--dark);
  }

  .header-content p {
    color: var(--gray);
    margin-bottom: 0;
  }

  /* Dashboard Layout */
  .dashboard-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* Card Styles */
  .dashboard-card {
    background: white;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .card-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-header h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    display: flex;
    align-items: center;
  }

  .card-header h2 i {
    margin-right: 0.75rem;
    color: var(--primary);
  }

  .header-title {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .badge {
    background: var(--primary-light);
    color: var(--primary);
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* Search Box */
  .search-box {
    position: relative;
    width: 250px;
  }

  .search-box input {
    width: 100%;
    padding: 0.5rem 1rem 0.5rem 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.9rem;
  }

  .search-box i {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gray);
  }

  /* Card Body */
  .card-body {
    padding: 1.5rem;
  }

  /* Form Styles */
  .form-row {
    margin-bottom: 1.25rem;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--dark);
  }

  .required {
    color: var(--danger);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 1rem;
    transition: var(--transition);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
  }

  .form-group textarea {
    min-height: 120px;
    resize: vertical;
  }

  .form-actions {
    margin-top: 1.5rem;
  }

  /* Button Styles */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition);
    border: none;
    text-decoration: none;
  }

  .btn i {
    margin-right: 0.5rem;
  }

  .btn-primary {
    background: var(--primary);
    color: white;
  }

  .btn-primary:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
  }

  .btn-edit {
    background: rgba(67, 97, 238, 0.1);
    color: var(--primary);
    padding: 0.5rem;
    border-radius: 50%;
    width: 36px;
    height: 36px;
  }

  .btn-edit:hover {
    background: rgba(67, 97, 238, 0.2);
  }

  .btn-delete {
    background: rgba(220, 53, 69, 0.1);
    color: var(--danger);
    padding: 0.5rem;
    border-radius: 50%;
    width: 36px;
    height: 36px;
  }

  .btn-delete:hover {
    background: rgba(220, 53, 69, 0.2);
  }

  /* Table Styles */
  .responsive-table {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th {
    background: var(--light);
    color: var(--dark);
    font-weight: 600;
    text-align: left;
    padding: 1rem;
    white-space: nowrap;
  }

  td {
    padding: 1rem;
    border-top: 1px solid var(--border);
    vertical-align: middle;
  }

  /* Customer Cell */
  .customer-cell {
    min-width: 180px;
  }

  .customer-info {
    display: flex;
    align-items: center;
  }

  .customer-name {
    font-weight: 500;
  }

  /* Testimonial Cell */
  .testimonial-cell {
    min-width: 300px;
    max-width: 400px;
  }

  .testimonial-preview {
    color: var(--gray);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Category Tag */
  .category-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--light-gray);
    color: var(--dark);
    border-radius: 50px;
    font-size: 0.85rem;
  }

  /* Actions Cell */
  .actions-cell {
    white-space: nowrap;
  }

  .action-buttons {
    display: flex;
    gap: 0.5rem;
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
  }

  .empty-icon {
    font-size: 3rem;
    color: var(--light-gray);
    margin-bottom: 1rem;
  }

  .empty-state h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--dark);
  }

  .empty-state p {
    color: var(--gray);
    margin-bottom: 0;
  }

  /* Responsive Adjustments */
  @media (min-width: 992px) {
    .dashboard-container {
      grid-template-columns: 400px 1fr;
    }

    .add-testimonial {
      position: sticky;
      top: 1rem;
      height: fit-content;
    }
  }

  @media (max-width: 768px) {
    .dashboard-header {
      padding: 1.25rem;
    }

    .dashboard-container {
      padding: 0 1.25rem;
    }

    .card-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .header-actions {
      width: 100%;
    }

    .search-box {
      width: 100%;
    }

    th, td {
      padding: 0.75rem;
    }
  }

  @media (max-width: 576px) {
    .dashboard-header {
      padding: 1rem;
    }

    .header-content h1 {
      font-size: 1.5rem;
    }

    .dashboard-container {
      padding: 0 1rem;
      gap: 1.5rem;
    }

    .card-body {
      padding: 1rem;
    }

    .form-group input,
    .form-group textarea {
      padding: 0.65rem 0.9rem;
    }

    .testimonial-cell {
      min-width: 200px;
    }
  }
</style>

<%- include('footer') %>