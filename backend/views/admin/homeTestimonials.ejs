<%- include('navbar') %>

<div class="testimonial-dashboard">
  <div class="dashboard-header">
    <div class="header-content">
      <h1>Testimonial Management</h1>
      <p>Collect, manage, and showcase customer feedback</p>
    </div>
  </div>

  <div class="dashboard-container">
    <!-- Add Testimonial Card -->
    <div class="dashboard-card add-testimonial">
      <div class="card-header">
        <div class="header-title">
          <div class="icon-circle bg-primary">
            <i class="fas fa-plus"></i>
          </div>
          <h2>Add New Testimonial</h2>
        </div>
      </div>
      <div class="card-body">
        <form action="/admin/save_home_testimonial" method="POST" enctype="multipart/form-data">
          <div class="form-group">
            <label for="name">Customer Name <span class="required">*</span></label>
            <div class="input-with-icon">
              <i class="fas fa-user"></i>
              <input type="text" id="name" name="name" required placeholder="John Smith">
            </div>
          </div>

          <div class="form-group">
            <label for="category">Category</label>
            <div class="input-with-icon">
              <i class="fas fa-tag"></i>
              <input type="text" id="category" name="category" placeholder="VIP Client">
            </div>
          </div>

          <div class="form-group">
            <label for="description">Testimonial Content <span class="required">*</span></label>
            <div class="textarea-with-icon">
              <i class="fas fa-comment"></i>
              <textarea id="description" name="description" rows="4" required placeholder="What they said about your service..."></textarea>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-block">
              <i class="fas fa-save"></i> Save Testimonial
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Testimonials List Card -->
    <div class="dashboard-card testimonial-list">
      <div class="card-header">
        <div class="header-title">
          <div class="icon-circle bg-secondary">
            <i class="fas fa-list"></i>
          </div>
          <div>
            <h2>Customer Testimonials</h2>
            <p class="card-subtitle"><%= homeTestimonialsResult.length %> testimonials</p>
          </div>
        </div>
        <div class="header-actions">
          <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Search testimonials...">
          </div>
        </div>
      </div>
      
      <div class="card-body">
        <% if (homeTestimonialsResult.length > 0) { %>
          <div class="responsive-table">
            <table>
              <thead>
                <tr>
                  <th>Customer</th>
                  <th>Testimonial</th>
                  <th>Category</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% for (let i = 0; i < homeTestimonialsResult.length; i++) { %>
                  <tr>
                    <td class="customer-cell">
                      <div class="customer-info">
                        <div class="customer-avatar">
                          <i class="fas fa-user-circle"></i>
                        </div>
                        <div>
                          <div class="customer-name"><%= homeTestimonialsResult[i].name %></div>
                          <div class="customer-id">#<%= homeTestimonialsResult[i].id %></div>
                        </div>
                      </div>
                    </td>
                    <td class="testimonial-cell">
                      <div class="testimonial-preview">
                        <%= homeTestimonialsResult[i].description.length > 100 ? 
                          homeTestimonialsResult[i].description.substring(0, 100) + '...' : 
                          homeTestimonialsResult[i].description %>
                      </div>
                    </td>
                    <td>
                      <span class="category-tag"><%= homeTestimonialsResult[i].category || 'General' %></span>
                    </td>
                    <td class="actions-cell">
                      <div class="action-buttons">
                        <a href="/admin/edit_home_testimonial/<%= homeTestimonialsResult[i].id %>" class="btn-action btn-edit" title="Edit">
                          <i class="fas fa-pencil-alt"></i>
                        </a>
                        <a href="/admin/delete_home_testimonial/<%= homeTestimonialsResult[i].id %>" 
                           class="btn-action btn-delete"
                           title="Delete"
                           onclick="return confirm('Are you sure you want to delete this testimonial?')">
                          <i class="fas fa-trash-alt"></i>
                        </a>
                      </div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          
          <div class="table-footer">
            <div class="table-pagination">
              <button class="btn-pagination" disabled>
                <i class="fas fa-chevron-left"></i>
              </button>
              <span class="pagination-info">1-<%= homeTestimonialsResult.length %> of <%= homeTestimonialsResult.length %></span>
              <button class="btn-pagination" disabled>
                <i class="fas fa-chevron-right"></i>
              </button>
            </div>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-icon">
              <i class="fas fa-comment-slash"></i>
            </div>
            <h3>No Testimonials Found</h3>
            <p>Add your first testimonial to showcase customer feedback</p>
            <button class="btn btn-primary">
              <i class="fas fa-plus"></i> Add Testimonial
            </button>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<style>
  /* Base Variables */
  :root {
    --primary: #4f46e5;
    --primary-light: #eef2ff;
    --primary-dark: #4338ca;
    --secondary: #64748b;
    --secondary-light: #f1f5f9;
    --success: #10b981;
    --danger: #ef4444;
    --warning: #f59e0b;
    --light: #f8fafc;
    --dark: #1e293b;
    --gray: #64748b;
    --gray-light: #cbd5e1;
    --border: #e2e8f0;
    --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    --radius: 0.5rem;
    --radius-lg: 0.75rem;
    --transition: all 0.2s ease-in-out;
  }

  /* Base Styles */
  .testimonial-dashboard {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--dark);
    line-height: 1.5;
    min-height: 100vh;
    background-color: #f8fafc;
  }

  /* Header Styles */
  .dashboard-header {
    background: white;
    padding: 1.5rem 2rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow);
    border-bottom: 1px solid var(--border);
  }

  .header-content h1 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    color: var(--dark);
  }

  .header-content p {
    color: var(--gray);
    margin-bottom: 0;
    font-size: 0.95rem;
  }

  /* Dashboard Layout */
  .dashboard-container {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 2rem 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  /* Card Styles */
  .dashboard-card {
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: var(--transition);
  }

  .dashboard-card:hover {
    box-shadow: var(--shadow-md);
  }

  .card-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: white;
  }

  .header-title {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .icon-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .bg-primary {
    background-color: var(--primary);
  }

  .bg-secondary {
    background-color: var(--secondary);
  }

  .card-header h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    color: var(--dark);
  }

  .card-subtitle {
    font-size: 0.875rem;
    color: var(--gray);
    margin-top: 0.25rem;
  }

  /* Search Box */
  .search-box {
    position: relative;
    width: 250px;
  }

  .search-box input {
    width: 100%;
    padding: 0.5rem 1rem 0.5rem 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.9rem;
    background-color: var(--light);
    transition: var(--transition);
  }

  .search-box input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
  }

  .search-box i {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gray);
    font-size: 0.9rem;
  }

  /* Card Body */
  .card-body {
    padding: 1.5rem;
  }

  /* Form Styles */
  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--dark);
    font-size: 0.875rem;
  }

  .required {
    color: var(--danger);
  }

  .input-with-icon, .textarea-with-icon {
    position: relative;
  }

  .input-with-icon i, .textarea-with-icon i {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gray);
    font-size: 0.9rem;
  }

  .textarea-with-icon i {
    top: 1rem;
    transform: none;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.95rem;
    transition: var(--transition);
    background-color: var(--light);
  }

  .form-group textarea {
    padding: 0.75rem 1rem 0.75rem 2.5rem;
    min-height: 120px;
    resize: vertical;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    background-color: white;
  }

  .form-actions {
    margin-top: 1.75rem;
  }

  /* Button Styles */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition);
    border: none;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .btn i {
    margin-right: 0.5rem;
    font-size: 0.9rem;
  }

  .btn-block {
    display: flex;
    width: 100%;
  }

  .btn-primary {
    background: var(--primary);
    color: white;
  }

  .btn-primary:hover {
    background: var(--primary-dark);
    transform: translateY(-1px);
  }

  .btn-action {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
    color: var(--gray);
    background-color: transparent;
    border: none;
    cursor: pointer;
  }

  .btn-edit:hover {
    color: var(--primary);
    background-color: rgba(79, 70, 229, 0.1);
  }

  .btn-delete:hover {
    color: var(--danger);
    background-color: rgba(239, 68, 68, 0.1);
  }

  .btn-pagination {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
    color: var(--gray);
    background-color: transparent;
    border: 1px solid var(--border);
    cursor: pointer;
  }

  .btn-pagination:hover:not(:disabled) {
    color: var(--primary);
    border-color: var(--primary);
  }

  .btn-pagination:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Table Styles */
  .responsive-table {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-bottom: 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 800px;
  }

  th {
    background: var(--secondary-light);
    color: var(--dark);
    font-weight: 600;
    text-align: left;
    padding: 1rem;
    white-space: nowrap;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  td {
    padding: 1rem;
    border-top: 1px solid var(--border);
    vertical-align: middle;
    font-size: 0.95rem;
  }

  /* Customer Cell */
  .customer-cell {
    min-width: 200px;
  }

  .customer-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .customer-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--primary-light);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
  }

  .customer-name {
    font-weight: 500;
    color: var(--dark);
  }

  .customer-id {
    font-size: 0.75rem;
    color: var(--gray);
    margin-top: 0.1rem;
  }

  /* Testimonial Cell */
  .testimonial-cell {
    min-width: 300px;
    max-width: 500px;
  }

  .testimonial-preview {
    color: var(--gray);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.6;
  }

  /* Category Tag */
  .category-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--light);
    color: var(--dark);
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid var(--border);
  }

  /* Actions Cell */
  .actions-cell {
    white-space: nowrap;
  }

  .action-buttons {
    display: flex;
    gap: 0.5rem;
  }

  /* Table Footer */
  .table-footer {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding-top: 1rem;
  }

  .table-pagination {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .pagination-info {
    font-size: 0.875rem;
    color: var(--gray);
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    background-color: var(--light);
  }

  .empty-icon {
    font-size: 3rem;
    color: var(--gray-light);
    margin-bottom: 1.5rem;
    opacity: 0.7;
  }

  .empty-state h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--dark);
    font-weight: 600;
  }

  .empty-state p {
    color: var(--gray);
    margin-bottom: 1.5rem;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Responsive Adjustments */
  @media (min-width: 1024px) {
    .dashboard-container {
      grid-template-columns: 380px 1fr;
    }

    .add-testimonial {
      position: sticky;
      top: 1rem;
      height: fit-content;
    }
  }

  @media (max-width: 768px) {
    .dashboard-header {
      padding: 1.25rem;
    }

    .dashboard-container {
      padding: 0 1.25rem 1.25rem;
    }

    .card-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1rem;
    }

    .header-actions {
      width: 100%;
    }

    .search-box {
      width: 100%;
    }

    .card-body {
      padding: 1rem;
    }
  }

  @media (max-width: 576px) {
    .dashboard-header {
      padding: 1rem;
    }

    .header-content h1 {
      font-size: 1.5rem;
    }

    .dashboard-container {
      padding: 0 1rem 1rem;
      gap: 1rem;
    }

    .form-group input,
    .form-group textarea {
      padding: 0.65rem 0.9rem 0.65rem 2.25rem;
    }

    .input-with-icon i, .textarea-with-icon i {
      left: 0.75rem;
    }

    .empty-state {
      padding: 2rem 1rem;
    }
  }
</style>

<%- include('footer') %>