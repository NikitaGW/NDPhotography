<%- include('navbar') %>

<div class="container-fluid px-md-5 py-4">
  <div class="card shadow-sm border-0">
    <div class="card-header bg-white border-0 pt-4 pb-3">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <h2 class="h4 mb-3 mb-md-0 fw-semibold text-dark">
          <i class="fas fa-camera-retro me-2 text-primary"></i>Photography Inquiries
        </h2>
        <div class="d-flex">
          <div class="input-group input-group-sm" style="max-width: 250px;">
            <input type="text" class="form-control" placeholder="Search inquiries...">
            <button class="btn btn-primary" type="button">
              <i class="fas fa-search"></i>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="card-body px-0 pb-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th class="text-nowrap">ID</th>
              <th>Client</th>
              <th>Contact</th>
              <th>Details</th>
              <th class="text-nowrap">Date/Time</th>
              <th>Message</th>
              <th class="text-nowrap">Submitted</th>
            </tr>
          </thead>
          <tbody>
            <% if (inquiries.length > 0) { %>
              <% inquiries.forEach(inquiry => { %>
                <tr class="align-middle">
                  <td class="fw-semibold text-muted">#<%= inquiry.id %></td>
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="fas fa-user text-muted"></i>
                      </div>
                      <div class="ms-2">
                        <div class="fw-medium"><%= inquiry.full_name %></div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <div class="small text-muted">
                      <div><i class="fas fa-envelope me-1 text-primary"></i> <%= inquiry.email %></div>
                      <% if (inquiry.phone) { %>
                        <div class="mt-1"><i class="fas fa-phone me-1 text-primary"></i> <%= inquiry.phone %></div>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <div class="small">
                      <span class="badge bg-light text-dark border"><%= inquiry.photography_type %></span>
                      <% if (inquiry.location) { %>
                        <div class="mt-1 text-truncate" style="max-width: 150px;" title="<%= inquiry.location %>">
                          <i class="fas fa-map-marker-alt me-1 text-danger"></i> <%= inquiry.location %>
                        </div>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <div class="small">
                      <% if (inquiry.preferred_date) { %>
                        <div><i class="far fa-calendar me-1 text-primary"></i> <%= new Date(inquiry.preferred_date).toISOString().split('T')[0] %></div>
                      <% } %>
                      <% if (inquiry.preferred_slot) { %>
                        <div class="mt-1"><i class="far fa-clock me-1 text-primary"></i> <%= inquiry.preferred_slot %></div>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <% if (inquiry.message) { %>
                      <button class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="<%= inquiry.message %>">
                        <i class="fas fa-eye"></i> View
                      </button>
                    <% } else { %>
                      <span class="text-muted small">-</span>
                    <% } %>
                  </td>
                  <td class="small text-muted">
                    <% if (inquiry.created_at) { %>
                      <div><%= new Date(inquiry.created_at).toLocaleDateString() %></div>
                      <div><%= new Date(inquiry.created_at).toLocaleTimeString() %></div>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-5">
                  <div class="py-4">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No inquiries found</h5>
                    <p class="text-muted small">When clients submit inquiries, they'll appear here</p>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <% if (inquiries.length > 0) { %>
        <div class="px-4 py-3 border-top d-flex flex-column flex-md-row justify-content-between align-items-center">
          <div class="small text-muted mb-2 mb-md-0">
            Showing <span class="fw-semibold">1</span> to <span class="fw-semibold"><%= inquiries.length %></span> of <span class="fw-semibold"><%= inquiries.length %></span> entries
          </div>
          <nav>
            <ul class="pagination pagination-sm mb-0">
              <li class="page-item disabled">
                <a class="page-link" href="#" tabindex="-1">Previous</a>
              </li>
              <li class="page-item active"><a class="page-link" href="#">1</a></li>
              <li class="page-item">
                <a class="page-link" href="#">Next</a>
              </li>
            </ul>
          </nav>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('footer') %>

<style>
  @media (max-width: 768px) {
    .table-responsive {
      border: 0;
    }
    .table thead {
      display: none;
    }
    .table tr {
      display: block;
      margin-bottom: 1rem;
      border: 1px solid #dee2e6;
      border-radius: 0.25rem;
    }
    .table td {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem;
      border-bottom: 1px solid #dee2e6;
    }
    .table td:before {
      content: attr(data-label);
      font-weight: 600;
      padding-right: 1rem;
      color: #495057;
    }
    .table td:last-child {
      border-bottom: 0;
    }
  }
</style>

<script>
  // Add responsive data labels for mobile view
  document.addEventListener('DOMContentLoaded', function() {
    if (window.innerWidth < 768) {
      const headers = ['ID', 'Client', 'Contact', 'Details', 'Date/Time', 'Message', 'Submitted'];
      const cells = document.querySelectorAll('tbody td');
      
      cells.forEach((cell, index) => {
        const headerIndex = index % headers.length;
        cell.setAttribute('data-label', headers[headerIndex]);
      });
    }
    
    // Initialize tooltips
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.map(function (tooltipTriggerEl) {
      return new bootstrap.Tooltip(tooltipTriggerEl);
    });
  });
</script>