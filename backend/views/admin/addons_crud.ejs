<%- include('navbar') %>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom py-3">
          <div class="d-flex justify-content-between align-items-center flex-wrap">
            <h2 class="h4 mb-0">
              <i class="bi bi-collection-play text-primary me-2"></i>
              Photography Add-Ons
            </h2>
            <div class="d-flex gap-2 mt-2 mt-sm-0">
              <div class="input-group input-group-sm" style="width: 200px;">
                <span class="input-group-text bg-light">
                  <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" id="searchAddons" class="form-control" placeholder="Search add-ons...">
              </div>
              <a href="/admin/addons/add" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Add New
              </a>
            </div>
          </div>
        </div>
        
        <div class="card-body p-0">
          <% if (addons.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                  <tr>
                    <th width="25%">Title</th>
                    <th width="15%">Price</th>
                    <th width="50%">Description</th>
                    <th width="10%" class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody id="addonsTable">
                  <% addons.forEach(item => { %>
                    <tr>
                      <td class="fw-semibold"><%= item.title %></td>
                      <td>₹<%= parseFloat(item.price).toFixed(2) %></td>
                      <td class="text-truncate" style="max-width: 300px;" title="<%= item.description %>">
                        <%= item.description.length > 50 ? item.description.substring(0, 50) + '...' : item.description %>
                      </td>
                      <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end">
                          <a href="/admin/addons/edit/<%= item.id %>" class="btn btn-sm btn-outline-primary" title="Edit">
                            <i class="bi bi-pencil"></i>
                          </a>
                          <a href="/admin/addons/delete/<%= item.id %>" 
                             class="btn btn-sm btn-outline-danger" 
                             title="Delete"
                             onclick="return confirm('Are you sure you want to delete this add-on?')">
                            <i class="bi bi-trash"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-5">
              <i class="bi bi-box text-muted" style="font-size: 3rem;"></i>
              <h5 class="mt-3 text-muted">No Add-Ons Found</h5>
              <p class="text-muted">Get started by adding your first photography add-on</p>
              <a href="/admin/addons/add" class="btn btn-primary mt-2">
                <i class="bi bi-plus-lg me-1"></i>Add Add-On
              </a>
            </div>
          <% } %>
        </div>
        
        <% if (addons.length > 0) { %>
          <div class="card-footer bg-white border-top py-2">
            <small class="text-muted">Showing <%= addons.length %> add-on<%= addons.length !== 1 ? 's' : '' %></small>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<style>
  .table td {
    vertical-align: middle;
  }
  .text-truncate {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 768px) {
    .card-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .table-responsive {
      font-size: 0.875rem;
    }
    .table thead {
      display: none;
    }
    .table tr {
      display: block;
      margin-bottom: 1rem;
      border: 1px solid #dee2e6;
      border-radius: 0.25rem;
    }
    .table td {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem;
      border-bottom: 1px solid #f0f0f0;
    }
    .table td:before {
      content: attr(data-label);
      font-weight: 600;
      margin-right: 1rem;
      flex: 0 0 100px;
    }
    .table td.text-end {
      justify-content: flex-end;
    }
    .text-truncate {
      white-space: normal;
    }
  }
</style>

<script>
  // Make table rows clickable on mobile
  document.querySelectorAll('#addonsTable tr').forEach(row => {
    row.setAttribute('data-label', 'Add-On');
    row.querySelectorAll('td').forEach((cell, index) => {
      const headers = ['Title', 'Price', 'Description', 'Actions'];
      if (index < headers.length) {
        cell.setAttribute('data-label', headers[index]);
      }
    });
  });

  // Search functionality
  document.getElementById('searchAddons').addEventListener('input', function() {
    const searchValue = this.value.toLowerCase();
    const rows = document.querySelectorAll('#addonsTable tr');
    
    rows.forEach(row => {
      const text = row.textContent.toLowerCase();
      row.style.display = text.includes(searchValue) ? '' : 'none';
    });
  });
</script>

<%- include('footer') %>