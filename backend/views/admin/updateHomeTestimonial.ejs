<%- include('navbar') %>

<div class="testimonial-update-container">
  <div class="update-header">
    <h1 class="update-title">Update Testimonial</h1>
    <p class="update-subtitle">Edit customer testimonial details</p>
  </div>

  <div class="update-card">
    <form action="/admin/update_home_testimonial" method="POST" enctype="multipart/form-data" class="update-form">
      <input type="hidden" name="id" value="<%=testimonial.id%>">
      
      <!-- Current Photo Preview -->
      <% if (testimonial.photo) { %>
      <div class="photo-preview">
        <div class="current-photo-container">
          <label class="form-label">Current Photo</label>
          <div class="photo-wrapper">
            <img src="/images/<%= testimonial.photo %>" alt="Current testimonial photo" class="current-photo">
            <div class="photo-overlay">
              <span class="photo-text">Current Photo</span>
            </div>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Name Field -->
      <div class="form-group">
        <label for="name" class="form-label">Customer Name <span class="required">*</span></label>
        <input type="text" id="name" name="name" class="form-input" value="<%= testimonial.name %>" required>
      </div>

      <!-- Category Field -->
      <div class="form-group">
        <label for="category" class="form-label">Category</label>
        <input type="text" id="category" name="category" class="form-input" value="<%= testimonial.category %>">
      </div>

      <!-- Description Field -->
      <div class="form-group">
        <label for="description" class="form-label">Testimonial Content <span class="required">*</span></label>
        <textarea id="description" name="description" class="form-textarea" rows="5" required><%= testimonial.description %></textarea>
      </div>

      <!-- Photo Upload (Commented out as in original) -->
      <!--
      <div class="form-group">
        <label for="photo" class="form-label">Change Photo</label>
        <div class="file-upload">
          <label for="photo" class="file-label">
            <span class="file-text">Choose new photo...</span>
            <span class="file-button">Browse</span>
          </label>
          <input type="file" id="photo" name="photo" class="file-input">
          <input type="hidden" name="old_photo" value="<%= testimonial.photo %>">
        </div>
        <small class="file-hint">Recommended: Square image (200x200px)</small>
      </div>
      -->

      <!-- Form Actions -->
      <div class="form-actions">
        <button type="submit" class="submit-button">
          <i class="fas fa-save"></i> Update Testimonial
        </button>
        <a href="/admin/home_testimonials" class="cancel-button">
          <i class="fas fa-times"></i> Cancel
        </a>
      </div>
    </form>
  </div>
</div>

<style>
  /* Base Styles */
  :root {
    --primary: #4a6bff;
    --primary-hover: #3a5bef;
    --secondary: #6c757d;
    --light: #f8f9fa;
    --dark: #212529;
    --border: #e0e3e8;
    --shadow: 0 2px 10px rgba(0, 0, 0, 0.08);
    --radius: 8px;
    --transition: all 0.2s ease;
  }

  .testimonial-update-container {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1.5rem;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }

  .update-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .update-title {
    color: var(--dark);
    font-size: 2rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .update-subtitle {
    color: var(--secondary);
    font-size: 1.1rem;
  }

  /* Form Card */
  .update-card {
    background: white;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 2rem;
  }

  /* Photo Preview */
  .photo-preview {
    margin-bottom: 2rem;
    text-align: center;
  }

  .current-photo-container {
    display: inline-block;
    text-align: center;
  }

  .photo-wrapper {
    position: relative;
    display: inline-block;
    margin-top: 0.5rem;
  }

  .current-photo {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--border);
  }

  .photo-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    padding: 0.5rem;
    border-bottom-left-radius: 75px;
    border-bottom-right-radius: 75px;
  }

  .photo-text {
    font-size: 0.85rem;
  }

  /* Form Elements */
  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--dark);
  }

  .required {
    color: #dc3545;
  }

  .form-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 1rem;
    transition: var(--transition);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(74, 107, 255, 0.1);
  }

  .form-textarea {
    width: 100%;
    min-height: 150px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 1rem;
    resize: vertical;
    transition: var(--transition);
  }

  .form-textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(74, 107, 255, 0.1);
  }

  /* File Upload (commented but styled for if enabled) */
  .file-upload {
    margin-top: 0.5rem;
  }

  .file-label {
    display: flex;
    cursor: pointer;
  }

  .file-text {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius) 0 0 var(--radius);
    background: var(--light);
    color: var(--secondary);
  }

  .file-button {
    padding: 0.75rem 1.25rem;
    background: var(--primary);
    color: white;
    border-radius: 0 var(--radius) var(--radius) 0;
    font-weight: 500;
    transition: var(--transition);
  }

  .file-button:hover {
    background: var(--primary-hover);
  }

  .file-input {
    display: none;
  }

  .file-hint {
    display: block;
    margin-top: 0.5rem;
    color: var(--secondary);
    font-size: 0.85rem;
  }

  /* Form Actions */
  .form-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }

  .submit-button {
    flex: 1;
    padding: 0.75rem;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: var(--radius);
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .submit-button i {
    margin-right: 0.5rem;
  }

  .submit-button:hover {
    background: var(--primary-hover);
    transform: translateY(-1px);
  }

  .cancel-button {
    flex: 1;
    padding: 0.75rem;
    background: white;
    color: var(--secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cancel-button i {
    margin-right: 0.5rem;
  }

  .cancel-button:hover {
    background: var(--light);
    transform: translateY(-1px);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .testimonial-update-container {
      padding: 0 1rem;
    }

    .update-card {
      padding: 1.5rem;
    }

    .update-title {
      font-size: 1.7rem;
    }

    .current-photo {
      width: 120px;
      height: 120px;
    }
  }

  @media (max-width: 576px) {
    .form-actions {
      flex-direction: column;
    }

    .submit-button,
    .cancel-button {
      width: 100%;
    }

    .update-title {
      font-size: 1.5rem;
    }

    .update-subtitle {
      font-size: 1rem;
    }
  }
</style>

<script>
  // If enabling file upload, uncomment this script
