<%- include('navbar') %>

<div class="container mt-5">
  <h2 class="mb-4">Edit Photography Result</h2>

  <form action="/admin/update_result/<%= result[0].id %>" method="POST" enctype="multipart/form-data">
    
    <div class="mb-3">
      <label for="title" class="form-label">Title</label>
      <input type="text" class="form-control" id="title" name="title" value="<%= result[0].title %>" required>
    </div>

    <div class="mb-3">
      <label for="description" class="form-label">Description</label>
      <textarea class="form-control" id="description" name="description" rows="4" required><%= result[0].description %></textarea>
    </div>

    <div class="mb-3">
      <label for="style" class="form-label">Style</label>
      <input type="text" class="form-control" id="style" name="style" value="<%= result[0].style %>" required>
    </div>

    <div class="mb-3">
      <label for="experience" class="form-label">Experience</label>
      <input type="text" class="form-control" id="experience" name="experience" value="<%= result[0].experience %>" required>
    </div>

    <div class="mb-3">
      <label for="categories" class="form-label">Categories</label>
      <input type="text" class="form-control" id="categories" name="categories" value="<%= result[0].categories %>" required>
    </div>

    <div class="mb-3">
      <label for="image" class="form-label">Image</label><br>
      <% if (result[0].image) { %>
        <img src="/images/<%= result[0].image %>" alt="Result Image" width="200" class="mb-2">
      <% } %>
      <input type="file" class="form-control" id="image" name="image">
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a href="/admin/results" class="btn btn-secondary">Cancel</a>
  </form>
</div>

<%- include('footer') %>
