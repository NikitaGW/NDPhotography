<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ND Photography | Capturing Moments That Matter</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Swiper CSS -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css"
/>

   <link rel="stylesheet" href="/user/home.css">
</head>
<body>
    <%- include('Navbar') %>
    <!-- Hero Section -->
    <section class="hero-section d-flex align-items-center">
        <!-- Hero Slides -->
        <div class="hero-slide active" style="background-image: url('/images/<%=sliderSql[0].image1%>');"></div>
        <div class="hero-slide" style="background-image: url('/images/<%= sliderSql[0].image2%>');"></div>
        <div class="hero-slide" style="background-image: url('/images/<%= sliderSql[0].image3%>');"></div>

        <!-- Overlay -->
        <div class="hero-overlay"></div>
        
        <!-- Hero Content -->
        <div class="container hero-content text-center">
            <h1 class="tagline mb-3 animate-on-scroll"><%= sliderSql[0].heading%></h1>
            <p class="sub-tagline animate-on-scroll delay-1"><%=sliderSql[0].description%></p>
            <div class="d-flex justify-content-center gap-3 animate-on-scroll delay-2">
                <a href="<%= sliderSql[0].button1_link%>" class="btn btn-primary btn-lg"><%= sliderSql[0].button1_text%></a>
                <a href="<%= sliderSql[0].button2_link%>" class="btn btn-outline-light btn-lg"><%= sliderSql[0].button2_text%></a>
            </div>
        </div>
    </section>

    <!-- Featured Portfolio Section -->
    <section id="portfolio" class="portfolio-section">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-4 fw-bold section-heading animate-on-scroll">Featured Work</h2>
                <p class="lead animate-on-scroll delay-1">A selection of our recent projects</p>
            </div>
            
            <div class="row">
                <!-- Portfolio Item 1 -->
                <% for(let i = 0; i < featureResult.length; i++) { %>
                <div class="col-md-6 col-lg-4">
                    <div class="portfolio-item animate-on-scroll">
                        <img src="/images/<%= featureResult[i].featured_image %>" alt="<%= featureResult[i].feature_heading %>">
                        <div class="portfolio-overlay">
                            <h3><%= featureResult[i].feature_heading %></h3>
                            <p><%= featureResult[i].feature_subheading %></p>
                        </div>
                    </div>
                </div>
            <% } %>
            <div class="text-center mt-5">
                <a href="/portfolio" class="btn btn-primary btn-lg animate-on-scroll">View Full Portfolio</a>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="services-section bg-light">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-4 fw-bold section-heading animate-on-scroll">Our Services</h2>
                <p class="lead animate-on-scroll delay-1">Professional photography for all occasions</p>
            </div>
            
            <div class="row">
                <%for(let i = 0;i < servicesSql.length; i++) { %>
                <!-- Wedding Photography -->
                <div class="col-md-6 col-lg-3" >

                    <div class="service-card text-center p-4 animate-on-scroll border border-primary">
                        <div class="service-icon">
                            <img src="/images/<%-servicesSql[i].icon_path %>" alt="">
                            <!-- <i class="fas fa-ring"></i> -->
                        </div>
                        <h3><%- servicesSql[i].category %></h3>
                        <p><%- servicesSql[i].description %></p>
                        <a href="/services" class="btn btn-outline-primary">Learn More</a>
                    </div>
                </div>
                <% } %>
                
            </div>
        </div>
    </section>
    <!-- testonomial -->
    <section class="testimonials" id="testimonials">
        <!-- <h1 class="heading">Testimonials</h1> -->
        <div class="text-center mb-5 para">
            <h2 class="display-4 fw-bold section-heading animate-on-scroll">Testimonials</h2>
            <p class="lead animate-on-scroll delay-1">Hear what our happy clients have to say about us</p>
        </div>
        <div class="overlay">
            <div class="swiper testimonials-slider">
                <div class="swiper-wrapper">
                    <% for(let i = 0;i < homeTestimonialsSql.length;i++) {%>
                    <div class="swiper-slide box">
                        <i class="fas fa-quote-left quote-icon"></i>
                        <p><%- homeTestimonialsSql[i].description %></p>
                        <h4><%- homeTestimonialsSql[i].name %></h4>
                        <span><%- homeTestimonialsSql[i].category %></span>
                    </div>
                    <%}%>
                </div>
                <div class="swiper-pagination"></div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
            </div>
            <a href="/testimonials" class="btn btn-outline-light btn-lg read-more-btn">Read More</a>
        </div>
    </section>

    <!-- call to action -->
    <section class="cta-section" id="cta">
        <div class="text-center mb-3 para">
            <h2 class="display-4 fw-bold section-heading animate-on-scroll">Let’s Tell Your Story</h2>
            <p class="lead animate-on-scroll delay-1">Every frame we capture is a piece of your journey</p>
        </div>
        <div class="cta-container">
            <div class="cta-wrapper">
                <div class="cta-image">
                    <img src="/images/cta.jpg" alt="Camera Setup" />
                </div>

                <div class="cta-content">
                    <h3>Capture Stories That Last a Lifetime</h3>
                    <p class="lead">
                        At ND Photography, we don't just click pictures — we tell emotional, timeless stories. From
                        candid wedding shots to corporate portraits, our camera lens captures it all with artistry and
                        passion.
                    </p>
                    <ul class="features">
                        <li><i class="fas fa-circle-check"></i> Candid & Documentary Style</li>
                        <li><i class="fas fa-circle-check"></i> 10+ Years of Photography Experience</li>
                        <li><i class="fas fa-circle-check"></i> Wedding, Fashion, Corporate & Events</li>
                    </ul>

                    <div class="cta-buttons">
                        <a href="/contact" class="btn btn-primary btn-lg">
                            <i class="fas fa-calendar-check"></i> Book a Session
                        </a>
                        <a href="/portfolio" class="btn btn-outline-light btn-lg" id="portfolio-btn">
                            <i class="fas fa-image"></i> View Portfolio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <%- include('footer') %>

    <!-- Bootstrap JS and Popper.js -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>

    <!-- Custom JavaScript -->
    <script src="/user/home.js"></script>
</body>
</html>