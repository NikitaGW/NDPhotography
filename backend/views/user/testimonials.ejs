<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <!-- Bootstrap 5 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <!-- font icon -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <!-- AOS CSS CDN -->
    <!-- <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" /> -->
    <link rel="stylesheet" href="/user/testimonials.css" />
  </head>
  <body>
    <%- include('Navbar') %>
    <!-- Testimonials  -->
    <section class="client-testimonial py-5">
      <div class="container">
        <div class="testimonial-heading text-center mb-5">
          <p class="text-muted">Client</p>
          <h2 class="fw-bold">FEEDBACK</h2>
          <p class="text-muted">
            Discover what our clients have to say about their experience with
            ND-Photography. From weddings to portraits, their words reflect the
            passion and dedication we bring to every shot.
          </p>
        </div>

        <!-- Wedding -->
        <% for(let i = 0; i < result.length; i++){%>
        <div class="testimonial-row">
          <div class="testimonial-img">
            <img
              src="/images/<%- result[i].testimonial_Image%>"
              alt="Client - Sarah & John"
            />
          </div>
          <div class="testimonial-text">
            <i class="fas fa-quote-left quote-icon"></i>
            <p><%- result[i].testimonial_description%></p>
            <h4><%- result[i].client_name%></h4>
            <span><%- result[i].client_category%></span>
          </div>
        </div>
        <%}%>

        <!-- Portrait -->
        <!-- <div class="testimonial-row row-reverse">
          <div class="testimonial-img">
            <img src="/images/portraitgirl.jpg" alt="Client - Emma Blake" />
          </div>
          <div class="testimonial-text">
            <i class="fas fa-quote-left quote-icon"></i>
            <p>
              As someone camera-shy, I was nervous for my portrait session, but
              ND-Photography made it incredibly comfortable. The final portraits
              reflected my personality and were beyond what I imagined. Their
              ability to bring out natural expressions is unmatched.
            </p>
            <h4>Emma Blake</h4>
            <span>Portrait Client</span>
          </div>
        </div> -->
      </div>
    </section>

    <section class="testimonialcta-section text-white">
      <div class="container text-center">
        <h2 class="fw-bold mb-3">Loved Their Experience?</h2>
        <p class="lead mb-4">
          Book your personalized photography session today and let us turn your
          vision into reality.
        </p>
        <a
          href="contact.html"
          class="btn testimonialcta-btn btn-lg px-6 rounded-pill text-white"
          >Let’s Connect<i class="fa-solid fa-angle-right ms-2"></i
        ></a>
      </div>
    </section>
    <%- include('footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script> -->

    <script src="testimonialpage.js"></script>
  </body>
</html>
