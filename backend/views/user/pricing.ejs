<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <!-- Bootstrap 5 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <!-- <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" /> -->
    <link rel="stylesheet" href="/user/pricing.css" />
  </head>
  <body>
    <%- include('Navbar') %>
    <!-- Pricing Section -->
    <!-- Pricing Section -->
    <section class="pricing-section">
      <div class="container">
        <div class="section-header animate-on-scroll">
          <h2 class="section-title">Pricing & Packages</h2>
          <p class="section-subtitle">
            Choose the perfect photography package for your needs. All packages
            include high-resolution edited images.
          </p>
        </div>

        <div class="row">
          <% packages.forEach((pkg, index) => { %>
          <div
            class="col-md-4 animate-on-scroll <%= index === 1 ? 'delay-1' : index === 2 ? 'delay-2' : '' %>"
          >
            <div
              class="pricing-card" style="<%= index === 1 ? 'transform: scale(1.05);' : '' %>"      >
              <% if(index === 1) { %>
              <div class="popular-tag">Most Popular</div>
              <% } %>
              <div
                class="pricing-header"
                style="<%= index === 1 ? 'background-color: var(--secondary-color);' : '' %>"
              >
                <h3 class="pricing-title"><%= pkg.name %></h3>
                <p class="pricing-price">₹<%= pkg.price %></p>
                <p class="pricing-period">per session</p>
              </div>
              <div class="pricing-body">
                <ul class="pricing-features">
                  <% pkg.features.forEach(f => { %>
                  <li class="<%= f.disabled ? 'disabled' : '' %>">
                    <%= f.text %>
                  </li>
                  <% }) %>
                </ul>
                <a
                  href="#contact"
                  class="btn <%= index === 1 ? 'btn-dark' : 'btn-primary' %> btn-pricing"
                  >Book Now</a
                >
              </div>
            </div>
          </div>
          <% }); %>
        </div>

        <!-- Custom Packages -->
        <div class="custom-packages animate-on-scroll">
          <h3 class="custom-title">Custom Packages & Add-ons</h3>
          <p>
            Tailor your photography experience with these additional services:
          </p>

          <div class="row">
            <% addonsResult.forEach(addon => { %>
            <div class="col-md-6">
              <div class="addon-card">
                <h4 class="addon-title"><%= addon.title %></h4>
                <p class="addon-price"><%= addon.price %></p>
                <p><%= addon.description %></p>
              </div>
            </div>
            <% }) %>
          </div>

          <!-- <div class="text-center mt-4">
        <a href="#contact" class="btn btn-outline-primary">Request Custom Package</a>
    </div> -->
        </div>

        <!-- FAQ Section -->
        <div class="faq-section animate-on-scroll">
          <h3 class="custom-title">FAQs About Pricing & Booking</h3>

          <div class="accordion" id="faqAccordion">
            <!-- FAQ Item 2 -->
            <% for(let i = 0; i < faqResult.length; i++) { %>
            <div class="faq-item">
              <h4
                class="faq-question collapsed"
                data-bs-toggle="collapse"
                data-bs-target="#faq<%= i %>"
              >
                <%= faqResult[i].question %>
              </h4>
              <div
                id="faq<%= i %>"
                class="collapse faq-answer"
                data-bs-parent="#faqAccordion"
              >
                <%= faqResult[i].answer %>
              </div>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </section>
    <%- include('footer') %>
    <!-- Bootstrap JS and Popper.js -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      // Scroll Animation
      document.addEventListener("DOMContentLoaded", function () {
        const animateElements = document.querySelectorAll(".animate-on-scroll");

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("animated");
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: "0px 0px -50px 0px",
          }
        );

        animateElements.forEach((el) => observer.observe(el));
      });
    </script>
  </body>
</html>
