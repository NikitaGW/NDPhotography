<%- include('navbar')%>
    <style>
        :root {
            --primary-color: #2c3e50;
            --secondary-color: #e74c3c;
            --light-color: #f8f9fa;
            --dark-color: #212529;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f8f9fa;
            color: #333;
        }

        .booking-wrapper {
            max-width: 1000px;
            margin: 30px auto;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            display: flex;
            flex-wrap: wrap;
        }

        .info-section {
            background: linear-gradient(rgba(44, 62, 80, 0.85), rgba(44, 62, 80, 0.8)),
                        url('https://images.unsplash.com/photo-1493863641943-9b68992a8d07?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80') center/cover no-repeat;
            color: #fff;
            padding: 30px 25px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            border-top-left-radius: 12px;
            border-bottom-left-radius: 12px;
            text-shadow: 1px 1px 4px rgba(0,0,0,0.6);
            border-right: 1px solid rgba(255, 255, 255, 0.1);
        }

        .info-section h2 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #fff;
        }

        .info-section h2 i {
            margin-right: 10px;
            color: #e74c3c;
        }

        .info-section p {
            font-size: 16px;
            line-height: 1.5;
            color: #f8f8f8;
            margin-bottom: 0;
        }

        .form-section {
            padding: 25px 30px;
        }

        .form-section h3 {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 10px;
        }

        .form-section .subtitle {
            font-size: 14px;
            color: #6c757d;
            margin-bottom: 20px;
        }

        label {
            font-size: 14.5px;
            font-weight: bold;
            margin-bottom: 4px;
            color: var(--primary-color);
        }

        .form-control-sm, .form-select-sm {
            font-size: 16px;
            padding: 0.4rem 0.55rem;
            border-radius: 6px;
            border: 1px solid #ced4da;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--secondary-color);
            box-shadow: 0 0 0 0.2rem rgba(231, 76, 60, 0.25);
        }

        .btn-primary {
            background-color: var(--secondary-color);
            border: none;
            border-radius: 6px;
            padding: 10px 0;
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background-color: #c0392b;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .required-field::after {
            content: " *";
            color: var(--secondary-color);
        }

        @media (max-width: 768px) {
            .booking-wrapper {
                flex-direction: column;
                border-radius: 10px;
                margin: 20px 15px;
            }

            .info-section {
                border-radius: 12px 12px 0 0;
                text-align: center;
                padding: 25px 20px;
                border-right: none;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            }

            .form-section {
                padding: 20px;
            }

            .form-section h3 {
                font-size: 20px;
                text-align: center;
            }

            .form-section form {
                display: flex;
                flex-direction: column;
            }

            .row.mb-2 {
                flex-direction: column;
            }

            .row.mb-2 > div {
                width: 100%;
                margin-bottom: 12px;
            }

            .btn {
                font-size: 16px;
                padding: 12px;
            }
        }

        /* Animation */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .booking-wrapper {
            animation: fadeIn 0.6s ease-out forwards;
        }
    </style>
</head>
<body>
    <!-- Main Booking Form -->
    <div class="container my-5 d-flex justify-content-center">
        <div class="booking-wrapper row g-0">
            <!-- Left: Info Section -->
            <div class="col-md-5 info-section">
                <h2><i class="fas fa-camera-retro"></i>Book with ND Photography</h2>
                <p>Whether it's a wedding, portrait session, or commercial shoot — we capture your story beautifully. Fill the form and let's create something amazing!</p>
                
                <div class="mt-4">
                    <h4><i class="fas fa-check-circle"></i> Why Choose Us?</h4>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-check me-2"></i> Professional Equipment</li>
                        <li><i class="fas fa-check me-2"></i> Creative Direction</li>
                        <li><i class="fas fa-check me-2"></i> High-Quality Editing</li>
                        <li><i class="fas fa-check me-2"></i> Quick Turnaround</li>
                    </ul>
                </div>
            </div>

            <!-- Right: Form Section -->
            <div class="col-md-7 form-section">
                <h3>Book Your Session</h3>
                <p class="subtitle">Fill in your details and we'll get back to you within 24 hours.</p>

                <form action="/save_booking" method="post">
                    <div class="mb-3">
                        <label for="name" class="form-label required-field">Full Name</label>
                        <input type="text" class="form-control form-control-sm" id="name" name="full_name" required>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label required-field">Email Address</label>
                        <input type="email" class="form-control form-control-sm" id="email" name="email" required>
                    </div>

                    <div class="mb-3">
                        <label for="phone" class="form-label required-field">Phone Number</label>
                        <input type="tel" class="form-control form-control-sm" id="phone" name="phone" required>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="service" class="form-label required-field">Photography Type</label>
                            <select class="form-select form-select-sm" id="service" name="photography_type" required>
                                <option value="" disabled selected>Select service</option>
                                <option>Wedding Photography</option>
                                <option>Portrait Session</option>
                                <option>Event Coverage</option>
                                <option>Commercial Shoot</option>
                                <option>Family Photography</option>
                                <option>Other</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="location" class="form-label required-field">Location</label>
                            <input type="text" class="form-control form-control-sm" id="location" name="location" placeholder="e.g., Pune" required>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="date" class="form-label required-field">Preferred Date</label>
                            <input type="date" class="form-control form-control-sm" id="date" name="preferred_date" required>
                        </div>
                        <div class="col-md-6">
                            <label for="slot" class="form-label required-field">Preferred Time</label>
                            <select class="form-select form-select-sm" id="slot" name="preferred_slot" required>
                                <option value="" disabled selected>Select time</option>
                                <option>Morning (8am-12pm)</option>
                                <option>Afternoon (12pm-4pm)</option>
                                <option>Evening (4pm-8pm)</option>
                                <option>Custom Time</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="message" class="form-label">Special Requests</label>
                        <textarea class="form-control form-control-sm" id="message" name="message" rows="3" placeholder="Tell us about your vision, special requirements, or anything else we should know"></textarea>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="newsletter" name="newsletter">
                        <label class="form-check-label" for="newsletter">
                            Subscribe to our newsletter for tips and special offers
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-paper-plane me-2"></i> Submit Booking Request
                    </button>
                </form>
            </div>
        </div>
    </div>
<%- include('footer')%>
