<%- include('navbar')%>

<style>
    :root {
        --primary-color: #2c3e50;
        --secondary-color: #e74c3c;
        --accent-color: #3498db;
        --light-color: #f8f9fa;
        --dark-color: #212529;
        --border-radius: 8px;
        --box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    body {
        font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: #f8f9fa;
        color: #333;
        line-height: 1.6;
    }

    .booking-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .booking-card {
        display: flex;
        background: #fff;
        border-radius: var(--border-radius);
        box-shadow: var(--box-shadow);
        overflow: hidden;
        transition: var(--transition);
    }

    .booking-card:hover {
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
    }

    .info-section {
        flex: 0 0 40%;
        background: linear-gradient(135deg, rgba(44, 62, 80, 0.9), rgba(44, 62, 80, 0.95)),
                    url('https://images.unsplash.com/photo-1493863641943-9b68992a8d07?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80') center/cover no-repeat;
        color: #fff;
        padding: 40px 30px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        z-index: 1;
    }

    .info-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(44, 62, 80, 0.8), rgba(44, 62, 80, 0.9));
        z-index: -1;
    }

    .info-section h2 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 15px;
        color: #fff;
        position: relative;
        padding-bottom: 15px;
    }

    .info-section h2::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 60px;
        height: 3px;
        background-color: var(--secondary-color);
    }

    .info-section p {
        font-size: 16px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 25px;
    }

    .benefits-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .benefits-list li {
        position: relative;
        padding-left: 30px;
        margin-bottom: 12px;
        font-size: 15px;
    }

    .benefits-list li::before {
        content: '\f00c';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        position: absolute;
        left: 0;
        top: 2px;
        color: var(--secondary-color);
    }

    .form-section {
        flex: 0 0 60%;
        padding: 40px;
    }

    .form-header {
        margin-bottom: 30px;
    }

    .form-header h3 {
        font-size: 24px;
        font-weight: 700;
        color: var(--primary-color);
        margin-bottom: 8px;
    }

    .form-header p {
        color: #6c757d;
        font-size: 15px;
        margin-bottom: 0;
    }

    .form-label {
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
        color: var(--primary-color);
    }

    .required-field::after {
        content: " *";
        color: var(--secondary-color);
    }

    .form-control {
        height: 45px;
        border-radius: var(--border-radius);
        border: 1px solid #e0e0e0;
        font-size: 15px;
        transition: var(--transition);
        padding: 10px 15px;
    }

    .form-control:focus {
        border-color: var(--accent-color);
        box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.2);
    }

    textarea.form-control {
        min-height: 100px;
        resize: vertical;
    }

    .form-select {
        height: 45px;
        font-size: 15px;
        border-radius: var(--border-radius);
        border: 1px solid #e0e0e0;
        padding: 10px 15px;
    }

    .form-select:focus {
        border-color: var(--accent-color);
        box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.2);
    }

    .btn-submit {
        background-color: var(--secondary-color);
        color: white;
        border: none;
        border-radius: var(--border-radius);
        padding: 12px 25px;
        font-size: 16px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: var(--transition);
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .btn-submit:hover {
        background-color: #c0392b;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(231, 76, 60, 0.3);
    }

    .form-check {
        margin-bottom: 25px;
    }

    .form-check-input {
        margin-top: 0.2em;
    }

    .form-check-label {
        font-size: 14px;
        color: #555;
    }

    /* Animations */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .booking-card {
        animation: fadeInUp 0.6s ease-out forwards;
    }

    /* Responsive Design */
    @media (max-width: 992px) {
        .booking-card {
            flex-direction: column;
        }
        
        .info-section, .form-section {
            flex: 0 0 100%;
        }
        
        .info-section {
            padding: 30px;
            text-align: center;
        }
        
        .info-section h2::after {
            left: 50%;
            transform: translateX(-50%);
        }
        
        .benefits-list {
            max-width: 400px;
            margin: 0 auto;
        }
    }

    @media (max-width: 768px) {
        .booking-container {
            margin: 20px auto;
            padding: 0 15px;
        }
        
        .form-section {
            padding: 30px;
        }
        
        .form-header h3 {
            font-size: 22px;
        }
    }

    @media (max-width: 576px) {
        .info-section {
            padding: 25px 20px;
        }
        
        .form-section {
            padding: 25px 20px;
        }
        
        .form-header h3 {
            font-size: 20px;
        }
        
        .btn-submit {
            padding: 21px 20px;
            font-size: 15px;
        }
    }
</style>

<!-- Main Booking Form -->
<div class="booking-container">
    <div class="booking-card">
        <!-- Left: Info Section -->
        <div class="info-section">
            <h2><i class="fas fa-camera-retro me-2"></i>Book Your Session</h2>
            <p>Let us capture your special moments with professional photography services tailored to your needs. Complete the form and we'll contact you to finalize details.</p>
            
            <ul class="benefits-list">
                <li>Professional-grade equipment</li>
                <li>Creative direction and posing guidance</li>
                <li>High-resolution edited images</li>
                <li>Fast delivery with online gallery</li>
                <li>Flexible scheduling options</li>
            </ul>
            
            <div class="mt-auto pt-3">
                <div class="d-flex align-items-center">
                    <i class="fas fa-phone-alt me-3"></i>
                    <div>
                        <small class="d-block text-white-50">Have questions?</small>
                        <strong>+1 (555) 123-4567</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Form Section -->
        <div class="form-section">
            <div class="form-header">
                <h3>Booking Request</h3>
                <p>Fill out the form below and we'll get back to you within 24 hours to confirm your session.</p>
            </div>

            <form action="/save_booking" method="post">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="name" class="form-label required-field">Full Name</label>
                        <input type="text" class="form-control" id="name" name="full_name" required placeholder="John Smith">
                    </div>
                    <div class="col-md-6">
                        <label for="email" class="form-label required-field">Email</label>
                        <input type="email" class="form-control" id="email" name="email" required placeholder="your@email.com">
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="phone" class="form-label required-field">Phone</label>
                        <input type="tel" class="form-control" id="phone" name="phone" required placeholder="+1 (___) ___-____">
                    </div>
                    <div class="col-md-6">
                        <label for="service" class="form-label required-field">Session Type</label>
                        <select class="form-select" id="service" name="photography_type" required>
                            <option value="" disabled selected>Select session type</option>
                            <option>Wedding Photography</option>
                            <option>Engagement Session</option>
                            <option>Family Portraits</option>
                            <option>Maternity Session</option>
                            <option>Professional Headshots</option>
                            <option>Commercial Photography</option>
                            <option>Other</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="date" class="form-label required-field">Preferred Date</label>
                        <input type="date" class="form-control" id="date" name="preferred_date" required>
                    </div>
                    <div class="col-md-6">
                        <label for="slot" class="form-label required-field">Preferred Time</label>
                        <select class="form-select" id="slot" name="preferred_slot" required>
                            <option value="" disabled selected>Select time slot</option>
                            <option>Sunrise (5-8am)</option>
                            <option>Morning (8am-12pm)</option>
                            <option>Afternoon (12-4pm)</option>
                            <option>Golden Hour (4-7pm)</option>
                            <option>Evening (7-10pm)</option>
                            <option>Flexible</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label required-field">Location</label>
                    <input type="text" class="form-control" id="location" name="location" required placeholder="Studio, outdoor location, or address">
                </div>

                <div class="mb-3">
                    <label for="message" class="form-label">Special Requests</label>
                    <textarea class="form-control" id="message" name="message" rows="3" placeholder="Tell us about your vision, special requirements, or anything else we should know"></textarea>
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" id="newsletter" name="newsletter" checked>
                    <label class="form-check-label" for="newsletter">
                        Subscribe to our newsletter for photography tips and special offers
                    </label>
                </div>

                <button type="submit" class="btn btn-submit">
                    <i class="fas fa-paper-plane me-1"></i> Request Booking
                </button>
            </form>
        </div>
    </div>
</div>

<%- include('footer')%>

<script>
    // Enhance form functionality
    document.addEventListener('DOMContentLoaded', function() {
        // Phone number formatting
        const phoneInput = document.getElementById('phone');
        if (phoneInput) {
            phoneInput.addEventListener('input', function(e) {
                const x = e.target.value.replace(/\D/g, '').match(/(\d{0,3})(\d{0,3})(\d{0,4})/);
                e.target.value = !x[2] ? x[1] : '(' + x[1] + ') ' + x[2] + (x[3] ? '-' + x[3] : '');
            });
        }

        // Date picker minimum date (today)
        const dateInput = document.getElementById('date');
        if (dateInput) {
            const today = new Date().toISOString().split('T')[0];
            dateInput.min = today;
        }
    });
</script>